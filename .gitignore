# ===== 构建产物 =====
build/
Debug/
Release/

# ===== CubeIDE / Eclipse 生成的启动配置（含本机绝对路径，跨机无用）=====
*.launch

# ===== Python 缓存 =====
__pycache__/
*.pyc

# ===== tools/ 的本地状态缓存（记录本机串口号与烧录器路径）=====
#   内容是本机专属的绝对路径 / COM 口，对别人无意义，也会泄漏本机目录结构
tools/.cli_path
tools/.last_port

# ===== 本地测试日志 / 采集数据（非源码）=====
logs/

# ===== 本地项目数据（WorkBuddy）=====
.workbuddy/

# ===== 临时 / 备份文件 =====
*.bak*
*.tmp
*~

# ===== 操作系统 / 编辑器 =====
.DS_Store
Thumbs.db
*.swp
